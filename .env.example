# Copy to .env and fill in. Never commit the real .env.
# Every external service runs in sandbox/test mode until real accounts exist.

# Supabase (database, auth). Create a project at https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Payment gateway: "sandbox" until a Qatar gateway account (SADAD, SkipCash or Tap) is opened.
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=

# SMS one-time codes: "console" prints codes in the logs instead of sending them.
SMS_PROVIDER=console
SMS_API_KEY=
